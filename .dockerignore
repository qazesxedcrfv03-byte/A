# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets — never bake secrets into the image
.env
.env.local
.env.*.local

# Duplicate backup directory (old server copies)
MyProject(Sever)/

# Local runtime data (evidence images, attendance JSON, etc.)
server/data/
server/storage/
*.db
*.db-journal

# TLS certificates — never bake certs into the image (Caddy handles TLS in Compose)
*.pem
*.crt

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
