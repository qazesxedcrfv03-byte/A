# ─────────────────────────────────────────────────────────────────
# can-attendance — Environment variables (PLACEHOLDERS ONLY).
# Copy to .env and replace placeholders with real values.
# IMPORTANT: never commit the real .env file (see .gitignore / .dockerignore).
# ─────────────────────────────────────────────────────────────────

# Environment / runtime
# NODE_ENV: development | production  (distinguishes dev/test/prod)
# TZ: IANA timezone name (affects Node.js Date operations)
NODE_ENV=production
TZ=Asia/Bangkok

# Reverse proxy mode (Caddy, nginx, etc.)
# Set to "true" when serving behind a reverse proxy that routes /api/* to the backend
# services. The static server then injects relative API URLs (/api/evidence, etc.) so
# the browser makes same-origin requests through the proxy for HTTPS termination.
# Set to "false" for direct port access (development without a reverse proxy).
REVERSE_PROXY=false

# HTTPS / TLS (STEP 12)
# HTTPS_ENABLED: "true" to serve the static frontend over HTTPS directly (no Caddy).
#   When enabled, the static server auto-generates a self-signed dev cert if
#   HTTPS_KEY_PATH / HTTPS_CERT_PATH are not set. Also enables a built-in reverse
#   proxy so /api/* requests are forwarded to the backend services over the same
#   origin (prevents mixed-content issues).
# HTTPS_HSTS: "true" (default) to emit Strict-Transport-Security header.
# HTTPS_KEY_PATH / HTTPS_CERT_PATH: paths to PEM-encoded TLS key/cert (overrides
#   auto-generated dev certs; recommended for production local deployments).
HTTPS_ENABLED=false
HTTPS_HSTS=true
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# --- Reverse proxy / HTTPS (Caddy) ---
# CADDY_DOMAIN: domain name for Let's Encrypt certificate provisioning.
#   Set to your real domain for production HTTPS (e.g. attend.example.com).
#   Defaults to "localhost" (Caddy auto-generates a local cert).
# CADDY_EMAIL: email for Let's Encrypt account / certificate notifications.
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com

# --- No domain? Free HTTPS via tunnel (see docker-compose.tunnel.yml / docker-compose.ngrok.yml) ---
# Option A: docker-compose.tunnel.yml (Cloudflare quick tunnel) needs NO variables here at all.
# Option B: docker-compose.ngrok.yml (permanent free URL) needs these two:
#   NGROK_AUTHTOKEN: from https://dashboard.ngrok.com/get-started/your-authtoken
#   NGROK_DOMAIN: your free static domain from https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=
NGROK_DOMAIN=


# Service ports
# STATIC_PORT: Static frontend (index.html, JS, CSS, assets)
# EVIDENCE_PORT: Evidence storage API
# ATTENDANCE_PORT: Attendance API
STATIC_PORT=8080
EVIDENCE_PORT=3030
ATTENDANCE_PORT=3031

# Optional path overrides (leave empty for container defaults)
# STATIC_ROOT defaults to the project root inside the container
# EVIDENCE_STORAGE_DIR defaults to /app/server/storage/evidence
# EVIDENCE_DATA_DIR defaults to /app/server/data
STATIC_ROOT=
EVIDENCE_STORAGE_DIR=
EVIDENCE_DATA_DIR=

# Evidence storage service
# Maximum upload size in bytes
EVIDENCE_MAX_BYTES=524288
# Comma-separated allowed origins for CORS
EVIDENCE_ALLOWED_ORIGINS=*
# Bearer token for evidence storage API (REQUIRED in production)
EVIDENCE_ADMIN_TOKEN=change-me-evidence-token

# Attendance API service
# Comma-separated allowed origins for CORS
ATTENDANCE_ALLOWED_ORIGINS=*
# Bearer token for attendance API (REQUIRED in production)
ATTENDANCE_ADMIN_TOKEN=change-me-attendance-token

# Supabase (attendance-service.js + storage-service.js persistence)
# SUPABASE_URL: Project Settings → API → Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role secret key
#   (server-side only — NEVER expose this key to the browser/frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
# Storage bucket name used for evidence photos (created by supabase-schema.sql)
EVIDENCE_BUCKET=evidence-photos
